<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoCar.Desktop.ViewModels.Registrations"
        xmlns:views="using:AutoCar.Desktop.Views.Registrations"
        xmlns:controls="using:AutoCar.Desktop.Views.Shared"
        x:Class="AutoCar.Desktop.Views.Registrations.ClienteWindow"
        x:DataType="vm:ClienteFormViewModel"
        Width="860" Height="620"
        MinWidth="820" MinHeight="540"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Cliente"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BrushFundo}">

    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <controls:BarraTituloJanela Grid.Row="0" />
        <views:ClienteFormView Grid.Row="1" />
    </Grid>
</Window>
