<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoCar.Desktop.ViewModels.Registrations"
             xmlns:dtos="using:AutoCar.Application.Modules.Registrations.Fornecedores.DTOs"
             xmlns:conv="using:AutoCar.Desktop.Converters"
             x:Class="AutoCar.Desktop.Views.Registrations.FornecedoresView"
             x:DataType="vm:FornecedoresViewModel">

    <Panel>
        <!-- ===== LISTAGEM ===== -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="16"
              IsVisible="{Binding !MostrarFormulario}">

            <!-- Toolbar: título + Novo (esquerda) | busca (direita) -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Fornecedores"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTexto}"
                               VerticalAlignment="Center" />
                    <!-- Contador: etiqueta azul-clara (informação), cantos retos no padrão do sistema. -->
                    <Border Background="#DBEAFE"
                            BorderBrush="#3B82F6" BorderThickness="1"
                            CornerRadius="2" Padding="8,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TextoContador}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="#1E40AF" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Content="+ Novo fornecedor"
                        Classes="primario"
                        Command="{Binding NovoCommand}"
                        Cursor="Hand" />

                <TextBox Grid.Column="3" Width="260"
                         Watermark="Buscar por nome ou documento"
                         Text="{Binding Filtro}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Buscar"
                        Classes="secundario"
                        Command="{Binding BuscarCommand}"
                        Cursor="Hand" />
            </Grid>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                         IsVisible="{Binding Carregando}" />

            <!-- Container da tabela (Grid único injetado no code-behind, header sempre visível) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushFundoCard}"
                    BorderBrush="{DynamicResource BrushBorda}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Panel>
                    <!-- Tabela: header fixo + ListBox virtualizado (colunas 70,60,150,*,130,90). -->
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="28"
                              Background="{DynamicResource BrushFundoHeader}"
                              ColumnDefinitions="70,60,150,*,130,90">
                            <Border Grid.ColumnSpan="6" Height="1" Background="#CBD5E1"
                                    VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="0" Text="CÓDIGO"              Classes="th" />
                            <TextBlock Grid.Column="1" Text="TIPO"                Classes="th" />
                            <TextBlock Grid.Column="2" Text="DOCUMENTO"           Classes="th" />
                            <TextBlock Grid.Column="3" Text="NOME / RAZÃO SOCIAL" Classes="th" />
                            <TextBlock Grid.Column="4" Text="TELEFONE"            Classes="th" />
                            <TextBlock Grid.Column="5" Text="STATUS"              Classes="th" />
                        </Grid>

                        <TextBlock IsVisible="{Binding !Fornecedores.Count}"
                                   Text="Nenhum fornecedor cadastrado. Clique em &quot;+ Novo fornecedor&quot; para começar."
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextoMudo}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,40,0,0" />

                        <ListBox Name="ListaFornecedores"
                                 Classes="tabela"
                                 IsVisible="{Binding !!Fornecedores.Count}"
                                 ItemsSource="{Binding Fornecedores}"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="dtos:FornecedorListaDto">
                                    <Grid Height="28" Cursor="Hand" Background="Transparent"
                                          ColumnDefinitions="70,60,150,*,130,90">
                                        <Border Name="BarraSel" Grid.ColumnSpan="6" Width="3"
                                                Background="{DynamicResource BrushPrimario}"
                                                HorizontalAlignment="Left" IsVisible="False" />

                                        <TextBlock Grid.Column="0" Text="{Binding CodFornecedor}"
                                                   Classes="td mono" />
                                        <!-- Badge PF/PJ (azul/roxo) -->
                                        <Border Grid.Column="1"
                                                Background="{Binding TipoPessoa, Converter={x:Static conv:TipoPessoaFundoConverter.Instancia}}"
                                                CornerRadius="2" Padding="6,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="8,0">
                                            <TextBlock Text="{Binding TipoPessoa, Converter={x:Static conv:TipoPessoaTextoConverter.Instancia}}"
                                                       FontSize="10" FontWeight="Medium"
                                                       Foreground="{Binding TipoPessoa, Converter={x:Static conv:TipoPessoaTextoCorConverter.Instancia}}" />
                                        </Border>
                                        <!-- Documento com máscara CPF/CNPJ -->
                                        <TextBlock Grid.Column="2" Classes="td mono">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{x:Static conv:DocumentoMascaraConverter.Instancia}">
                                                    <Binding Path="Documento" />
                                                    <Binding Path="TipoPessoa" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding RazaoSocial}"
                                                   Classes="td" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding Telefone}"
                                                   Classes="td mono" />
                                        <Border Grid.Column="5"
                                                Background="{Binding FlgAtivo, Converter={x:Static conv:StatusAtivoFundoConverter.Instancia}}"
                                                CornerRadius="2" Padding="6,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="8,0">
                                            <TextBlock Text="{Binding FlgAtivo, Converter={x:Static conv:StatusAtivoTextoConverter.Instancia}}"
                                                       FontSize="10" FontWeight="Medium"
                                                       Foreground="{Binding FlgAtivo, Converter={x:Static conv:StatusAtivoTextoCorConverter.Instancia}}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <TextBlock Text="{Binding MensagemErro}"
                               IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource BrushErro}"
                               FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,40,0,0" />
                </Panel>
            </Border>
        </Grid>

        <!-- ===== FORMULÁRIO (sobreposto) ===== -->
        <ContentControl Content="{Binding FormularioAtivo}"
                        IsVisible="{Binding MostrarFormulario}" />
    </Panel>
</UserControl>
