<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoCar.Desktop.ViewModels.Registrations"
        xmlns:views="using:AutoCar.Desktop.Views.Registrations"
        xmlns:controls="using:AutoCar.Desktop.Views.Shared"
        x:Class="AutoCar.Desktop.Views.Registrations.ServicoWindow"
        x:DataType="vm:ServicoFormViewModel"
        Width="480" Height="340"
        MinWidth="440" MinHeight="300"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Serviço"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BrushFundo}">

    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <controls:BarraTituloJanela Grid.Row="0" />
        <views:ServicoFormView Grid.Row="1" />
    </Grid>
</Window>
