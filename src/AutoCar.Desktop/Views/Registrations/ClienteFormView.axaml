<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoCar.Desktop.ViewModels.Registrations"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:b="using:AutoCar.Desktop.Behaviors"
             x:Class="AutoCar.Desktop.Views.Registrations.ClienteFormView"
             x:DataType="vm:ClienteFormViewModel">

    <!-- ESC fecha o formulário (mesma ação do botão Cancelar/Fechar). -->
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelarCommand}" />
    </UserControl.KeyBindings>

    <Border Margin="16"
            Background="{DynamicResource BrushFundoCard}"
            BorderBrush="{DynamicResource BrushBorda}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <!-- HEADER -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BrushBorda}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding Titulo}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTexto}"
                               VerticalAlignment="Center" />
                    <Border Background="#E0F2FE" CornerRadius="2" Padding="6,2"
                            VerticalAlignment="Center" IsVisible="{Binding ModoVisualizacao}">
                        <TextBlock Text="VISUALIZAÇÃO" FontSize="10" FontWeight="Medium" Foreground="#075985" />
                    </Border>
                    <Border Background="#FEF3C7" CornerRadius="2" Padding="6,2"
                            VerticalAlignment="Center" IsVisible="{Binding !ModoVisualizacao}">
                        <TextBlock Text="EDIÇÃO" FontSize="10" FontWeight="Medium" Foreground="#92400E" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- CORPO denso agrupado em group boxes (DADOS GERAIS / ENDEREÇO / OBSERVAÇÃO) -->
            <ScrollViewer Grid.Row="1" Padding="16,12" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2" HorizontalAlignment="Left">

                    <!-- ===== DADOS GERAIS (group box) ===== -->
                    <HeaderedContentControl Classes="grupo" Header="DADOS GERAIS"
                                            Width="780" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <Grid RowSpacing="6" ColumnDefinitions="100,160,90,160,110,*">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><!-- 0: Tipo | Documento | Limite -->
                            <RowDefinition Height="Auto" /><!-- 1: Nome/Razão Social -->
                            <RowDefinition Height="Auto" /><!-- 2: Nome Fantasia (PJ) -->
                            <RowDefinition Height="Auto" /><!-- 3: Telefone | E-mail -->
                        </Grid.RowDefinitions>

                        <!-- Linha 0: Tipo | Documento | Limite de Crédito -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="formlabel" Text="Tipo Pessoa" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding TiposPessoa}"
                                  SelectedItem="{Binding TipoPessoa}"
                                  IsEnabled="{Binding !ModoVisualizacao}"
                                  HorizontalAlignment="Left" Width="120" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="formlabel" Text="{Binding TituloDocumento}" />
                        <DockPanel Grid.Row="0" Grid.Column="3" LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Classes="primario"
                                    Width="28" Padding="0"
                                    Margin="4,0,0,0"
                                    Command="{Binding ConsultarCnpjCommand}"
                                    IsVisible="{Binding PodeConsultarCnpj}"
                                    ToolTip.Tip="Consultar CNPJ na Receita"
                                    Cursor="Hand">
                                <i:Icon Value="fa-solid fa-magnifying-glass" FontSize="12"
                                        Foreground="{DynamicResource BrushTextoInverso}" />
                            </Button>
                            <TextBox Text="{Binding Documento}" IsEnabled="{Binding !ModoVisualizacao}"
                                     Watermark="Somente números" />
                        </DockPanel>
                        <TextBlock Grid.Row="0" Grid.Column="4" Classes="formlabel" Text="Limite Crédito" />
                        <TextBox Grid.Row="0" Grid.Column="5"
                                 Text="{Binding LimiteCreditoTexto}" IsEnabled="{Binding !ModoVisualizacao}"
                                 b:SelecionarTudoBehavior.Ativo="True"
                                 Watermark="0,00"
                                 HorizontalAlignment="Left" Width="120" />

                        <!-- Linha 1: Nome/Razão Social (campo longo) -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="formlabel" Text="{Binding TituloRazaoSocial}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                                 Text="{Binding RazaoSocial}" IsEnabled="{Binding !ModoVisualizacao}"
                                 b:MaiusculoBehavior.Ativo="True" />

                        <!-- Linha 2: Nome Fantasia (só PJ) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="formlabel" Text="Nome Fantasia"
                                   IsVisible="{Binding EhJuridica}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5"
                                 Text="{Binding NomeFantasia}" IsEnabled="{Binding !ModoVisualizacao}"
                                 b:MaiusculoBehavior.Ativo="True"
                                 IsVisible="{Binding EhJuridica}" />

                        <!-- Linha 3: Telefone | E-mail -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="formlabel" Text="Telefone" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Telefone}" IsEnabled="{Binding !ModoVisualizacao}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Classes="formlabel" Text="E-mail" />
                        <TextBox Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="3"
                                 Text="{Binding Email}" IsEnabled="{Binding !ModoVisualizacao}" />
                    </Grid>
                    </HeaderedContentControl>

                    <!-- ===== ENDEREÇO (group box) ===== -->
                    <HeaderedContentControl Classes="grupo" Header="ENDEREÇO"
                                            Width="780" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <Grid RowSpacing="6" ColumnDefinitions="100,160,90,160,110,*">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><!-- 0: CEP | Logradouro | Número -->
                            <RowDefinition Height="Auto" /><!-- 1: Complemento | Bairro -->
                            <RowDefinition Height="Auto" /><!-- 2: Cidade | UF -->
                        </Grid.RowDefinitions>

                        <!-- Linha 0: CEP | Logradouro | Número -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="formlabel" Text="CEP" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Cep}" IsEnabled="{Binding !ModoVisualizacao}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="formlabel" Text="Logradouro" />
                        <TextBox Grid.Row="0" Grid.Column="3"
                                 Text="{Binding Logradouro}" IsEnabled="{Binding !ModoVisualizacao}"
                                 b:MaiusculoBehavior.Ativo="True" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Classes="formlabel" Text="Número" />
                        <TextBox Grid.Row="0" Grid.Column="5"
                                 Text="{Binding Numero}" IsEnabled="{Binding !ModoVisualizacao}"
                                 HorizontalAlignment="Left" Width="90" />

                        <!-- Linha 1: Complemento | Bairro -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="formlabel" Text="Complemento" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Complemento}" IsEnabled="{Binding !ModoVisualizacao}"
                                 b:MaiusculoBehavior.Ativo="True" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="formlabel" Text="Bairro" />
                        <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                                 Text="{Binding Bairro}" IsEnabled="{Binding !ModoVisualizacao}"
                                 b:MaiusculoBehavior.Ativo="True" />

                        <!-- Linha 2: Cidade | UF -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="formlabel" Text="Cidade" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Cidade}" IsEnabled="{Binding !ModoVisualizacao}"
                                 b:MaiusculoBehavior.Ativo="True" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Classes="formlabel" Text="UF" />
                        <TextBox Grid.Row="2" Grid.Column="5"
                                 Text="{Binding Uf}" MaxLength="2" IsEnabled="{Binding !ModoVisualizacao}"
                                 HorizontalAlignment="Left" Width="60" />
                    </Grid>
                    </HeaderedContentControl>

                    <!-- ===== OBSERVAÇÃO (group box) ===== -->
                    <HeaderedContentControl Classes="grupo" Header="OBSERVAÇÃO"
                                            Width="780" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <TextBox Text="{Binding Observacao}" IsEnabled="{Binding !ModoVisualizacao}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="56"
                             VerticalContentAlignment="Top" />
                    </HeaderedContentControl>

                    <!-- mensagem de erro -->
                    <TextBlock Text="{Binding MensagemErro}"
                               IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource BrushErro}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="2"
                         IsVisible="{Binding Carregando}" />

            <!-- RODAPÉ dois modos -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BrushBorda}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Fechar" Classes="secundario"
                            Command="{Binding CancelarCommand}"
                            IsVisible="{Binding ModoVisualizacao}" Cursor="Hand" />
                    <Button Content="Editar" Classes="primario"
                            Command="{Binding HabilitarEdicaoCommand}"
                            IsVisible="{Binding ModoVisualizacao}" Cursor="Hand" />
                    <Button Content="Cancelar" Classes="secundario"
                            Command="{Binding CancelarCommand}"
                            IsVisible="{Binding !ModoVisualizacao}"
                            IsEnabled="{Binding !Carregando}" Cursor="Hand" />
                    <Button Content="Salvar" Classes="primario"
                            Command="{Binding SalvarCommand}"
                            IsVisible="{Binding !ModoVisualizacao}"
                            IsEnabled="{Binding !Carregando}" Cursor="Hand" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
