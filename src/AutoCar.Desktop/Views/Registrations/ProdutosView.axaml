<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoCar.Desktop.ViewModels.Registrations"
             xmlns:dtos="using:AutoCar.Application.Modules.Registrations.Produtos.DTOs"
             xmlns:conv="using:AutoCar.Desktop.Converters"
             x:Class="AutoCar.Desktop.Views.Registrations.ProdutosView"
             x:DataType="vm:ProdutosViewModel">

    <Panel>
        <!-- ===== LISTAGEM ===== -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="16"
              IsVisible="{Binding !MostrarFormulario}">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Produtos"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTexto}"
                               VerticalAlignment="Center" />
                    <!-- Contador: etiqueta azul-clara (informação), cantos retos no padrão do sistema. -->
                    <Border Classes="contador">
                        <TextBlock Classes="contador" Text="{Binding TextoContador}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Content="+ Novo produto"
                        Classes="primario"
                        Command="{Binding NovoCommand}"
                        Cursor="Hand" />

                <TextBox Grid.Column="3" Width="280"
                         Watermark="Buscar por descrição, código de barras ou fabricante"
                         Text="{Binding Filtro}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Buscar"
                        Classes="secundario"
                        Command="{Binding BuscarCommand}"
                        Cursor="Hand" />
            </Grid>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                         IsVisible="{Binding Carregando}" />

            <Border Grid.Row="2"
                    Background="{DynamicResource BrushFundoCard}"
                    BorderBrush="{DynamicResource BrushBorda}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">

                <!-- Mensagem de erro fica por cima do conteúdo se houver. -->
                <Panel>
                    <!-- Tabela: header fixo + ListBox virtualizado. As colunas do header e da linha
                         usam EXATAMENTE as mesmas larguras (80,*,140,130,50,90,90,90,90). O padding do
                         ListBoxItem é zerado no Tema (Style ListBox.tabela) para o '*' alinhar. -->
                    <DockPanel>
                        <!-- ===== HEADER FIXO ===== -->
                        <Grid DockPanel.Dock="Top" Height="28"
                              Background="{DynamicResource BrushFundoHeader}"
                              ColumnDefinitions="80,*,140,130,130,50,90,90,90,90">
                            <TextBlock Grid.Column="0" Text="CÓDIGO"    Classes="th" />
                            <TextBlock Grid.Column="1" Text="DESCRIÇÃO" Classes="th" />
                            <TextBlock Grid.Column="2" Text="CATEGORIA" Classes="th" />
                            <TextBlock Grid.Column="3" Text="GRUPO"     Classes="th" />
                            <TextBlock Grid.Column="4" Text="MARCA"     Classes="th" />
                            <TextBlock Grid.Column="5" Text="UN"        Classes="th" />
                            <TextBlock Grid.Column="6" Text="POSIÇÃO"   Classes="th" />
                            <TextBlock Grid.Column="7" Text="LADO"      Classes="th" />
                            <TextBlock Grid.Column="8" Text="VENDA"     Classes="th" />
                            <TextBlock Grid.Column="9" Text="STATUS"    Classes="th" />
                        </Grid>

                        <!-- ===== CORPO VIRTUALIZADO ===== -->
                        <!-- Vazio: mensagem central (some quando há itens). -->
                        <TextBlock IsVisible="{Binding !Produtos.Count}"
                                   Text="Nenhum produto cadastrado. Clique em &quot;+ Novo produto&quot; para começar."
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextoMudo}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,40,0,0" />

                        <ListBox Name="ListaProdutos"
                                 Classes="tabela"
                                 IsVisible="{Binding !!Produtos.Count}"
                                 ItemsSource="{Binding Produtos}"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="dtos:ProdutoListaDto">
                                    <Grid Height="28" Cursor="Hand" Background="Transparent"
                                          ColumnDefinitions="80,*,140,130,130,50,90,90,90,90">
                                        <!-- Barra azul da linha selecionada (visível via Style :selected). -->
                                        <Border Name="BarraSel" Grid.ColumnSpan="10" Width="3"
                                                Background="{DynamicResource BrushAcento}"
                                                HorizontalAlignment="Left" IsVisible="False" />

                                        <TextBlock Grid.Column="0" Text="{Binding CodProduto}"
                                                   Classes="td mono" />
                                        <TextBlock Grid.Column="1" Text="{Binding Descricao}"
                                                   Classes="td" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Categoria}"
                                                   Classes="td" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Grupo}"
                                                   Classes="td suave" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding Marca}"
                                                   Classes="td" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding Unidade}"
                                                   Classes="td" />
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding Posicao}"
                                                   Classes="td" />
                                        <TextBlock Grid.Column="7"
                                                   Text="{Binding Lado}"
                                                   Classes="td" />
                                        <TextBlock Grid.Column="8"
                                                   Text="{Binding VlrVenda, StringFormat='{}{0:N2}'}"
                                                   Classes="td mono" HorizontalAlignment="Right" />
                                        <Border Grid.Column="9"
                                                Background="{Binding FlgAtivo, Converter={x:Static conv:StatusAtivoFundoConverter.Instancia}}"
                                                CornerRadius="2" Padding="6,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="8,0">
                                            <TextBlock Text="{Binding FlgAtivo, Converter={x:Static conv:StatusAtivoTextoConverter.Instancia}}"
                                                       FontSize="10" FontWeight="Medium"
                                                       Foreground="{Binding FlgAtivo, Converter={x:Static conv:StatusAtivoTextoCorConverter.Instancia}}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <TextBlock Text="{Binding MensagemErro}"
                               IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource BrushErro}"
                               FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,40,0,0" />
                </Panel>
            </Border>
        </Grid>

        <!-- ===== FORMULÁRIO (sobreposto) ===== -->
        <ContentControl Content="{Binding FormularioAtivo}"
                        IsVisible="{Binding MostrarFormulario}" />
    </Panel>
</UserControl>
