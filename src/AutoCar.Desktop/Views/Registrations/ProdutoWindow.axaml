<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoCar.Desktop.ViewModels.Registrations"
        xmlns:views="using:AutoCar.Desktop.Views.Registrations"
        xmlns:controls="using:AutoCar.Desktop.Views.Shared"
        x:Class="AutoCar.Desktop.Views.Registrations.ProdutoWindow"
        x:DataType="vm:ProdutoFormViewModel"
        Width="850" Height="550"
        MinWidth="840" MinHeight="490"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Produto"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BrushFundo}">

    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <controls:BarraTituloJanela Grid.Row="0" />
        <views:ProdutoFormView Grid.Row="1" />
    </Grid>
</Window>
