<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AutoCar.Desktop.Views.Shared"
        x:Class="AutoCar.Desktop.Views.ImagemAmpliadaWindow"
        Width="600" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Foto do produto"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#1E293B"
        KeyDown="AoTeclar">

    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <controls:BarraTituloJanela Grid.Row="0" MostrarMinimizar="False" />
        <!-- Foto ampliada, centralizada. Clicar em qualquer lugar fecha (igual Esc). -->
        <Border Grid.Row="1" Background="#1E293B" Cursor="Hand" PointerPressed="AoClicar">
            <Image Name="Foto" Stretch="Uniform" Margin="24" />
        </Border>
    </Grid>
</Window>
