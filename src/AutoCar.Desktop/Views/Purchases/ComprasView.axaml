<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoCar.Desktop.ViewModels.Purchases"
             xmlns:dtos="using:AutoCar.Application.Modules.Purchases.Compras.DTOs"
             xmlns:conv="using:AutoCar.Desktop.Converters"
             x:Class="AutoCar.Desktop.Views.Purchases.ComprasView"
             x:DataType="vm:ComprasViewModel">

    <Panel>
        <!-- ===== LISTAGEM ===== (o formulário abre em janela separada — ver CompraWindow) -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="16">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Compras"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTexto}"
                               VerticalAlignment="Center" />
                    <!-- Contador: etiqueta azul-clara (informação), cantos retos no padrão do sistema. -->
                    <Border Background="#DBEAFE"
                            BorderBrush="#3B82F6" BorderThickness="1"
                            CornerRadius="2" Padding="8,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TextoContador}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="#1E40AF" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Content="+ Nova compra"
                        Classes="primario"
                        Command="{Binding NovoCommand}"
                        Cursor="Hand" />
            </Grid>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                         IsVisible="{Binding Carregando}" />

            <Border Grid.Row="2"
                    Background="{DynamicResource BrushFundoCard}"
                    BorderBrush="{DynamicResource BrushBorda}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Panel>
                    <!-- Tabela: header fixo + ListBox virtualizado (colunas 80,110,*,70,120). -->
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="28"
                              Background="{DynamicResource BrushFundoHeader}"
                              ColumnDefinitions="80,110,*,70,120">
                            <Border Grid.ColumnSpan="5" Height="1" Background="#CBD5E1"
                                    VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="0" Text="Nº"         Classes="th" />
                            <TextBlock Grid.Column="1" Text="DATA"       Classes="th" />
                            <TextBlock Grid.Column="2" Text="FORNECEDOR" Classes="th" />
                            <TextBlock Grid.Column="3" Text="ITENS"      Classes="th" />
                            <TextBlock Grid.Column="4" Text="TOTAL"      Classes="th" />
                        </Grid>

                        <TextBlock IsVisible="{Binding !Compras.Count}"
                                   Text="Nenhuma compra. Clique em &quot;+ Nova compra&quot; para começar."
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextoMudo}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,40,0,0" />

                        <ListBox Name="ListaCompras"
                                 Classes="tabela"
                                 IsVisible="{Binding !!Compras.Count}"
                                 ItemsSource="{Binding Compras}"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="dtos:CompraListaDto">
                                    <Grid Height="28" Cursor="Hand" Background="Transparent"
                                          ColumnDefinitions="80,110,*,70,120">
                                        <Border Name="BarraSel" Grid.ColumnSpan="5" Width="3"
                                                Background="{DynamicResource BrushPrimario}"
                                                HorizontalAlignment="Left" IsVisible="False" />

                                        <TextBlock Grid.Column="0" Text="{Binding CodCompra}"
                                                   Classes="td mono" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CriadoEm, Converter={x:Static conv:DataBrasiliaCurtaConverter.Instancia}}"
                                                   Classes="td mono" />
                                        <TextBlock Grid.Column="2" Text="{Binding NomeFornecedor}"
                                                   Classes="td" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding QtdItens}"
                                                   Classes="td mono" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding VlrTotal, StringFormat='{}{0:N2}'}"
                                                   Classes="td mono" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <TextBlock Text="{Binding MensagemErro}"
                               IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource BrushErro}"
                               FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,40,0,0" />
                </Panel>
            </Border>
        </Grid>
    </Panel>
</UserControl>
