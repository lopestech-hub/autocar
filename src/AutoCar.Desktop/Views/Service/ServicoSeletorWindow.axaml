<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dtos="using:AutoCar.Application.Modules.Registrations.Servicos.DTOs"
        xmlns:sel="using:AutoCar.Desktop.Views.Service"
        x:Class="AutoCar.Desktop.Views.Service.ServicoSeletorWindow"
        x:DataType="sel:ServicoSeletorWindow"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        xmlns:controls="using:AutoCar.Desktop.Views.Shared"
        Title="Selecionar serviço"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BrushFundo}"
        KeyDown="AoTeclar">

    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <controls:BarraTituloJanela Grid.Row="0" MostrarMinimizar="False" />
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Selecionar serviço"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTexto}" Margin="0,0,0,12" />

        <!-- Busca por descrição ou código -->
        <TextBox Grid.Row="1" Name="CampoBusca"
                 Watermark="Buscar por descrição ou código (digite e use as setas)"
                 Margin="0,0,0,12" />

        <Border Grid.Row="2"
                Background="{DynamicResource BrushFundoCard}"
                BorderBrush="{DynamicResource BrushBorda}" BorderThickness="1"
                CornerRadius="6" ClipToBounds="True">
            <Panel>
                <!-- Tabela: header fixo + ListBox virtualizado (colunas 70,*,130). -->
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="28"
                          Background="{DynamicResource BrushFundoHeader}"
                          ColumnDefinitions="70,*,130">
                        <TextBlock Grid.Column="0" Text="CÓDIGO"       Classes="th" />
                        <TextBlock Grid.Column="1" Text="DESCRIÇÃO"    Classes="th" />
                        <TextBlock Grid.Column="2" Text="VALOR PADRÃO" Classes="th" />
                    </Grid>

                    <TextBlock IsVisible="{Binding !Resultado.Count}"
                               Text="Nenhum serviço encontrado. Ajuste a busca."
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextoMudo}"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,40,0,0" />

                    <ListBox Name="ListaResultado"
                             Classes="tabela"
                             IsVisible="{Binding !!Resultado.Count}"
                             ItemsSource="{Binding Resultado}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="dtos:ServicoDto">
                                <Grid Height="28" Cursor="Hand" Background="Transparent"
                                      ColumnDefinitions="70,*,130">
                                    <Border Name="BarraSel" Grid.ColumnSpan="3" Width="3"
                                            Background="{DynamicResource BrushAcento}"
                                            HorizontalAlignment="Left" IsVisible="False" />

                                    <TextBlock Grid.Column="0" Text="{Binding CodServico}"
                                               Classes="td mono" />
                                    <TextBlock Grid.Column="1" Text="{Binding Descricao}"
                                               Classes="td" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding VlrPadrao, StringFormat='{}{0:N2}'}"
                                               Classes="td mono" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Panel>
        </Border>

        <Border Grid.Row="3" BorderBrush="{DynamicResource BrushBorda}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="Enter ou duplo-clique seleciona. Esc fecha."
                           FontSize="11" Foreground="{DynamicResource BrushTextoMudo}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Fechar" Classes="secundario"
                            Cursor="Hand" Click="AoFechar" />
                </StackPanel>
            </DockPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
