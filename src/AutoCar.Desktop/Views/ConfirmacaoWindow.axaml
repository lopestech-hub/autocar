<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AutoCar.Desktop.Views.ConfirmacaoWindow"
        Width="400" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirmação"
        Background="{DynamicResource BrushFundoCard}">

    <!-- Enter confirma, ESC cancela (KeyBindings tratados no code-behind via botões IsDefault/IsCancel). -->
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Name="Titulo" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTexto}" />
        <TextBlock Name="Mensagem" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushTextoSecundario}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="BotaoCancelar" Content="Cancelar" Classes="secundario"
                    IsCancel="True" Cursor="Hand" />
            <Button Name="BotaoConfirmar" Content="Confirmar" Classes="primario"
                    IsDefault="True" Cursor="Hand" />
        </StackPanel>
    </StackPanel>
</Window>
