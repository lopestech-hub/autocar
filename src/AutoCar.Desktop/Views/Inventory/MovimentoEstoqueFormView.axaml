<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoCar.Desktop.ViewModels.Inventory"
             xmlns:conv="using:AutoCar.Desktop.Converters"
             xmlns:dtos="using:AutoCar.Application.Modules.Estoque.DTOs"
             x:Class="AutoCar.Desktop.Views.Inventory.MovimentoEstoqueFormView"
             x:DataType="vm:MovimentoEstoqueFormViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="16">

        <!-- ===== CABEÇALHO: produto + saldo atual em destaque ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Produto" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource BrushTextoSecundario}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CodProduto}" FontSize="11"
                               FontFamily="{DynamicResource FonteMono}"
                               Foreground="{DynamicResource BrushTextoSecundario}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding DescricaoProduto}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTexto}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Saldo atual: faixa azul-clara, número grande (o que o operador mais olha). -->
            <Border Grid.Column="1" Background="{DynamicResource BrushFundoSelecionado}" CornerRadius="3"
                    Padding="16,6" VerticalAlignment="Center">
                <StackPanel Spacing="0">
                    <TextBlock Text="SALDO ATUAL" FontSize="9" FontWeight="Medium"
                               Foreground="{DynamicResource BrushTextoSecundario}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SaldoAtual}"
                               FontSize="22" FontWeight="Bold"
                               FontFamily="{DynamicResource FonteMono}"
                               Foreground="{DynamicResource BrushPrimario}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== SEÇÃO: MOVIMENTO ===== -->
        <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Classes="formsecao" Text="MOVIMENTO"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Border Classes="formsecaoLinha" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="6"
              Margin="0,0,0,12" HorizontalAlignment="Left">

            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formlabel" Text="Tipo"
                       Width="90" Margin="0,0,8,0" />
            <ComboBox Grid.Row="0" Grid.Column="1" Width="180"
                      ItemsSource="{Binding TiposMovimento}"
                      SelectedItem="{Binding TipoSelecionado}"
                      Margin="0,0,16,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcaoTipoMovimento">
                        <TextBlock Text="{Binding Rotulo}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="0" Grid.Column="2" Classes="formlabel" Text="Quantidade"
                       Width="90" Margin="0,0,8,0" />
            <TextBox Grid.Row="0" Grid.Column="3" Width="120"
                     Text="{Binding QuantidadeTexto}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formlabel" Text="Observação"
                       Width="90" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                     Watermark="Motivo do ajuste, nº da nota (opcional)"
                     Text="{Binding Observacao}"
                     MaxLength="255" />
        </Grid>

        <!-- ===== AÇÕES + feedback ===== -->
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,12">
            <ProgressBar IsIndeterminate="True" Height="2"
                         IsVisible="{Binding Processando}" />
            <TextBlock Text="{Binding MensagemErro}"
                       IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource BrushErro}"
                       FontSize="11" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancelar" Classes="secundario"
                        Command="{Binding CancelarCommand}"
                        Cursor="Hand" />
                <Button Content="Confirmar movimento" Classes="primario"
                        Command="{Binding ConfirmarCommand}"
                        IsEnabled="{Binding !Processando}"
                        Cursor="Hand" />
            </StackPanel>
        </StackPanel>

        <!-- ===== SEÇÃO: HISTÓRICO ===== -->
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*">
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Classes="formsecao" Text="HISTÓRICO"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border Classes="formsecaoLinha" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Header do histórico. Colunas fixas + OBS. na coluna * (única que estica). -->
            <Border Grid.Row="1" Background="{DynamicResource BrushFundoHeader}"
                    BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Height="28">
                <Grid ColumnDefinitions="55,120,90,50,65,90,90,*">
                    <TextBlock Grid.Column="0" Text="Nº" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="1" Text="DATA/HORA" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="TIPO" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="3" Text="QTD" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="8,0" />
                    <TextBlock Grid.Column="4" Text="SALDO" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="8,0" />
                    <TextBlock Grid.Column="5" Text="ORIGEM" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="6" Text="DOCUMENTO" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Column="7" Text="OBS." FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" VerticalAlignment="Center" Margin="8,0" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource BrushFundoCard}"
                    BorderBrush="{DynamicResource BrushBorda}"
                    BorderThickness="1,0,1,1"
                    ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Movimentos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dtos:MovimentoEstoqueDto">
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Height="26">
                                    <Grid ColumnDefinitions="55,120,90,50,65,90,90,*">
                                        <TextBlock Grid.Column="0" Text="{Binding CodMovimento}"
                                                   FontSize="12" FontFamily="{DynamicResource FonteMono}"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DataCriacao, Converter={x:Static conv:DataBrasiliaConverter.Instancia}}"
                                                   FontSize="12" FontFamily="{DynamicResource FonteMono}"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Tipo, Converter={x:Static conv:TipoMovimentoRotuloConverter.Instancia}}"
                                                   Foreground="{Binding Tipo, Converter={x:Static conv:TipoMovimentoCorConverter.Instancia}}"
                                                   FontSize="12" FontWeight="Medium"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Qtd}"
                                                   FontSize="12" FontFamily="{DynamicResource FonteMono}"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="8,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding QtdSaldoApos}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   FontFamily="{DynamicResource FonteMono}"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="8,0" />
                                        <!-- ORIGEM: só o tipo (Venda/Manual/Devolução) -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding Origem, Converter={x:Static conv:OrigemMovimentoRotuloConverter.Instancia}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0" />
                                        <!-- DOCUMENTO: só o número de referência (vazio se manual) -->
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding CodDocumentoOrigem, Converter={x:Static conv:DocumentoOrigemConverter.Instancia}}"
                                                   FontSize="12" FontFamily="{DynamicResource FonteMono}"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="7" Text="{Binding Observacao}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextoSecundario}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
