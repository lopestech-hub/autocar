<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoCar.Desktop.ViewModels.Inventory"
        xmlns:views="using:AutoCar.Desktop.Views.Inventory"
        xmlns:controls="using:AutoCar.Desktop.Views.Shared"
        x:Class="AutoCar.Desktop.Views.Inventory.MovimentoEstoqueWindow"
        x:DataType="vm:MovimentoEstoqueFormViewModel"
        Width="880" Height="600"
        MinWidth="720" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Movimentação de Estoque"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BrushFundo}">

    <!-- ESC fecha a janela sem registrar movimento. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelarCommand}" />
    </Window.KeyBindings>

    <!-- OffScreenMargin evita corte do conteúdo quando a janela é maximizada. -->
    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <controls:BarraTituloJanela Grid.Row="0" />
        <views:MovimentoEstoqueFormView Grid.Row="1" />
    </Grid>
</Window>
