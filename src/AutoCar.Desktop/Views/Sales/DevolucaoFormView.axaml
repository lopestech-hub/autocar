<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoCar.Desktop.ViewModels.Sales"
             x:Class="AutoCar.Desktop.Views.Sales.DevolucaoFormView"
             x:DataType="vm:DevolucaoFormViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="16">

        <!-- ===== CABEÇALHO ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Titulo}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTexto}" />
                <TextBlock Text="Selecione a quantidade de cada item que volta ao estoque."
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextoSecundario}" />
            </StackPanel>
            <!-- Selo: a devolução é uma reversão (entrada). Verde da família "entrada/devolução". -->
            <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#22C55E" BorderThickness="1"
                    CornerRadius="2" Padding="8,2" VerticalAlignment="Center">
                <TextBlock Text="DEVOLUÇÃO" FontSize="10" FontWeight="SemiBold" Foreground="#166534" />
            </Border>
        </Grid>

        <!-- ===== SEÇÃO: MOTIVO ===== -->
        <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Classes="formsecao" Text="MOTIVO"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Border Classes="formsecaoLinha" VerticalAlignment="Center" />
        </DockPanel>

        <TextBox Grid.Row="2"
                 Watermark="Motivo da devolução (opcional)"
                 Text="{Binding Motivo}"
                 MaxLength="255" Margin="0,0,0,12" />

        <!-- ===== SEÇÃO: ITENS ===== -->
        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Classes="formsecao" Text="ITENS"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Border Classes="formsecaoLinha" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Itens devolvíveis. PRODUTO estica (*); demais colunas fixas. -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BrushFundoHeader}"
                    BorderBrush="{DynamicResource BrushBorda}" BorderThickness="0,0,0,1" Height="28">
                <Grid ColumnDefinitions="*,90,110,100,90,90">
                    <TextBlock Grid.Column="0" Text="PRODUTO" Classes="th" />
                    <TextBlock Grid.Column="1" Text="VENDIDO" Classes="th" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="JÁ DEVOLV." Classes="th" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="DEVOLVÍVEL" Classes="th" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="UNIT." Classes="th" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="DEVOLVER" Classes="th" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource BrushFundoCard}"
                    BorderBrush="{DynamicResource BrushBorda}"
                    BorderThickness="1,0,1,1"
                    ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Itens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DevolucaoItemViewModel">
                                <Border BorderBrush="{DynamicResource BrushBordaSuave}" BorderThickness="0,0,0,1" MinHeight="30">
                                    <Grid ColumnDefinitions="*,90,110,100,90,90">
                                        <TextBlock Grid.Column="0" Text="{Binding DescricaoProduto}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding QtdVendida}"
                                                   FontSize="12" FontFamily="{DynamicResource FonteMono}"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding QtdJaDevolvida}"
                                                   FontSize="12" FontFamily="{DynamicResource FonteMono}"
                                                   Foreground="{DynamicResource BrushTextoSecundario}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="8,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding QtdDevolvivel}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   FontFamily="{DynamicResource FonteMono}"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="8,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding VlrUnitario, StringFormat='N2'}"
                                                   FontSize="12" FontFamily="{DynamicResource FonteMono}"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="8,0" />
                                        <!-- Quantidade a devolver: editável (0 = não devolve). Limitada ao devolvível no VM. -->
                                        <TextBox Grid.Column="5" Width="64"
                                                 Text="{Binding QtdDevolverTexto}"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center" Margin="8,2"
                                                 IsEnabled="{Binding QtdDevolvivel}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== AÇÕES + feedback ===== -->
        <StackPanel Grid.Row="5" Spacing="6" Margin="0,12,0,0">
            <ProgressBar IsIndeterminate="True" Height="2"
                         IsVisible="{Binding Carregando}" />
            <TextBlock Text="{Binding MensagemErro}"
                       IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource BrushErro}"
                       FontSize="11" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancelar" Classes="secundario"
                        Command="{Binding CancelarCommand}"
                        Cursor="Hand" />
                <Button Content="Devolver" Classes="primario"
                        Command="{Binding DevolverCommand}"
                        IsEnabled="{Binding !Carregando}"
                        Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
