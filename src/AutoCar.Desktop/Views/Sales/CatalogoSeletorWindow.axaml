<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cat="using:AutoCar.Desktop.Views.Catalogo"
        xmlns:controls="using:AutoCar.Desktop.Views.Shared"
        x:Class="AutoCar.Desktop.Views.Sales.CatalogoSeletorWindow"
        Width="980" Height="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Title="Catálogo: selecionar peça"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BrushFundo}"
        KeyDown="AoTeclar">

    <Grid RowDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
        <controls:BarraTituloJanela Grid.Row="0" MostrarMinimizar="False" />
        <Grid Grid.Row="1" RowDefinitions="*,Auto">
        <!-- O Catálogo em modo seletor: clicar numa linha escolhe a peça (ligado no code-behind). -->
        <cat:CatalogoView Grid.Row="0" Name="Catalogo" />

        <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorda}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock Name="Dica" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource BrushTextoMudo}" />
                <Button Content="Fechar" Classes="secundario"
                        HorizontalAlignment="Right" Cursor="Hand"
                        Click="AoFechar" />
            </DockPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
