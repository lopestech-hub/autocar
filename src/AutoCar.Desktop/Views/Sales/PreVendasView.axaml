<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoCar.Desktop.ViewModels.Sales"
             xmlns:dtos="using:AutoCar.Application.Modules.Sales.PreVendas.DTOs"
             xmlns:conv="using:AutoCar.Desktop.Converters"
             x:Class="AutoCar.Desktop.Views.Sales.PreVendasView"
             x:DataType="vm:PreVendasViewModel">

    <Panel>
        <!-- ===== LISTAGEM ===== (o formulário abre em janela separada — ver PreVendaWindow) -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="16">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Pré-vendas"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTexto}"
                               VerticalAlignment="Center" />
                    <!-- Contador: etiqueta azul-clara (informação), cantos retos no padrão do sistema. -->
                    <Border Background="#DBEAFE"
                            BorderBrush="#3B82F6" BorderThickness="1"
                            CornerRadius="2" Padding="8,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TextoContador}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="#1E40AF" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Content="+ Nova pré-venda"
                        Classes="primario"
                        Command="{Binding NovoCommand}"
                        Cursor="Hand" />

                <TextBox Grid.Column="3" Width="280"
                         Watermark="Buscar por cliente ou número"
                         Text="{Binding Filtro}"
                         Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Buscar"
                        Classes="secundario"
                        Command="{Binding BuscarCommand}"
                        Cursor="Hand" />
            </Grid>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                         IsVisible="{Binding Carregando}" />

            <Border Grid.Row="2"
                    Background="{DynamicResource BrushFundoCard}"
                    BorderBrush="{DynamicResource BrushBorda}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Panel>
                    <!-- Tabela: header fixo + ListBox virtualizado (colunas 80,110,*,70,110,110). -->
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="28"
                              Background="{DynamicResource BrushFundoHeader}"
                              ColumnDefinitions="80,110,*,70,110,110">
                            <Border Grid.ColumnSpan="6" Height="1" Background="#CBD5E1"
                                    VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="0" Text="Nº"       Classes="th" />
                            <TextBlock Grid.Column="1" Text="DATA"     Classes="th" />
                            <TextBlock Grid.Column="2" Text="CLIENTE"  Classes="th" />
                            <TextBlock Grid.Column="3" Text="ITENS"    Classes="th" />
                            <TextBlock Grid.Column="4" Text="TOTAL"    Classes="th" />
                            <TextBlock Grid.Column="5" Text="SITUAÇÃO" Classes="th" />
                        </Grid>

                        <TextBlock IsVisible="{Binding !PreVendas.Count}"
                                   Text="Nenhuma pré-venda. Clique em &quot;+ Nova pré-venda&quot; para começar."
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextoMudo}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,40,0,0" />

                        <ListBox Name="ListaPreVendas"
                                 Classes="tabela"
                                 IsVisible="{Binding !!PreVendas.Count}"
                                 ItemsSource="{Binding PreVendas}"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="dtos:PreVendaListaDto">
                                    <Grid Height="28" Cursor="Hand" Background="Transparent"
                                          ColumnDefinitions="80,110,*,70,110,110">
                                        <Border Name="BarraSel" Grid.ColumnSpan="6" Width="3"
                                                Background="{DynamicResource BrushPrimario}"
                                                HorizontalAlignment="Left" IsVisible="False" />

                                        <TextBlock Grid.Column="0" Text="{Binding CodPreVenda}"
                                                   Classes="td mono" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DataCriacao, Converter={x:Static conv:DataBrasiliaCurtaConverter.Instancia}}"
                                                   Classes="td mono" />
                                        <TextBlock Grid.Column="2" Text="{Binding Cliente}"
                                                   Classes="td" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding QtdItens}"
                                                   Classes="td mono" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding VlrTotal, StringFormat='{}{0:N2}'}"
                                                   Classes="td mono" HorizontalAlignment="Right" />
                                        <Border Grid.Column="5"
                                                Background="{Binding Situacao, Converter={x:Static conv:SituacaoPreVendaFundoConverter.Instancia}}"
                                                BorderBrush="{Binding Situacao, Converter={x:Static conv:SituacaoPreVendaBordaConverter.Instancia}}"
                                                BorderThickness="1" CornerRadius="2" Padding="6,1"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="8,0">
                                            <TextBlock Text="{Binding Situacao, Converter={x:Static conv:SituacaoPreVendaTextoConverter.Instancia}}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding Situacao, Converter={x:Static conv:SituacaoPreVendaTextoCorConverter.Instancia}}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <TextBlock Text="{Binding MensagemErro}"
                               IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource BrushErro}"
                               FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,40,0,0" />
                </Panel>
            </Border>
        </Grid>
    </Panel>
</UserControl>
