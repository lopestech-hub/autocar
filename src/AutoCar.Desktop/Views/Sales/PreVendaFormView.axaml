<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoCar.Desktop.ViewModels.Sales"
             xmlns:cli="using:AutoCar.Application.Modules.Registrations.Clientes.DTOs"
             xmlns:b="using:AutoCar.Desktop.Behaviors"
             xmlns:conv="using:AutoCar.Desktop.Converters"
             x:Class="AutoCar.Desktop.Views.Sales.PreVendaFormView"
             x:DataType="vm:PreVendaFormViewModel">

    <UserControl.Resources>
        <!-- Combo de cliente: razão social; item nulo = venda avulsa (Consumidor). -->
        <DataTemplate x:Key="ClienteTemplate" x:DataType="cli:ClienteListaDto">
            <TextBlock Text="{Binding RazaoSocial, FallbackValue=— (Consumidor), TargetNullValue=— (Consumidor)}" />
        </DataTemplate>
    </UserControl.Resources>

    <Panel>
        <Border Margin="16"
                Background="{DynamicResource BrushFundoCard}"
                BorderBrush="{DynamicResource BrushBorda}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

                <!-- HEADER -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BrushBorda}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Titulo}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTexto}"
                                   VerticalAlignment="Center" />
                        <Border Background="#E0F2FE" CornerRadius="2" Padding="6,2"
                                VerticalAlignment="Center" IsVisible="{Binding ModoVisualizacao}">
                            <TextBlock Text="VISUALIZAÇÃO" FontSize="10" FontWeight="Medium" Foreground="#075985" />
                        </Border>
                        <Border Background="#FEF3C7" CornerRadius="2" Padding="6,2"
                                VerticalAlignment="Center" IsVisible="{Binding !ModoVisualizacao}">
                            <TextBlock Text="EDIÇÃO" FontSize="10" FontWeight="Medium" Foreground="#92400E" />
                        </Border>
                        <!-- Vendedor (usuário logado), read-only — quem está registrando a venda. -->
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Vendedor:" FontSize="11"
                                       Foreground="{DynamicResource BrushTextoMudo}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NomeVendedor}" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource BrushTextoSecundario}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Dica do atalho F2 para abrir o catálogo de peças. -->
                        <Border Background="{DynamicResource BrushFundoHeader}"
                                BorderBrush="{DynamicResource BrushBorda}" BorderThickness="1"
                                CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                                IsVisible="{Binding !ModoVisualizacao}">
                            <TextBlock Text="F2 = buscar peça" FontSize="10"
                                       Foreground="{DynamicResource BrushTextoSecundario}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CORPO -->
                <ScrollViewer Grid.Row="1" Padding="16,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2" HorizontalAlignment="Left">

                        <!-- ===== DADOS ===== -->
                        <Grid ColumnDefinitions="Auto,*" Width="820" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Classes="formsecao" Text="DADOS" />
                            <Border Grid.Column="1" Classes="formsecaoLinha" />
                        </Grid>
                        <Grid RowSpacing="6" ColumnDefinitions="90,300,90,*">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><!-- 0: Cliente | Nome avulso -->
                                <RowDefinition Height="Auto" /><!-- 1: Montadora | Modelo -->
                                <RowDefinition Height="Auto" /><!-- 2: Ano | Placa -->
                                <RowDefinition Height="Auto" /><!-- 3: Observação -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formlabel" Text="Cliente" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Clientes}"
                                      SelectedItem="{Binding ClienteSelecionado}"
                                      ItemTemplate="{StaticResource ClienteTemplate}"
                                      IsEnabled="{Binding !ModoVisualizacao}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="formlabel" Text="Avulso" />
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding NomeClienteAvulso}"
                                     IsEnabled="{Binding ClienteAvulso}"
                                     b:MaiusculoBehavior.Ativo="True"
                                     Watermark="Nome do consumidor (sem cadastro)" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="formlabel" Text="Montadora" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding VeiculoMontadora}" IsEnabled="{Binding !ModoVisualizacao}"
                                     b:MaiusculoBehavior.Ativo="True"
                                     HorizontalAlignment="Left" Width="200"
                                     Watermark="VW, FIAT... (opcional)" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Classes="formlabel" Text="Modelo" />
                            <TextBox Grid.Row="1" Grid.Column="3"
                                     Text="{Binding VeiculoModelo}" IsEnabled="{Binding !ModoVisualizacao}"
                                     b:MaiusculoBehavior.Ativo="True"
                                     HorizontalAlignment="Left" Width="200"
                                     Watermark="GOL, PALIO... (opcional)" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formlabel" Text="Ano" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding VeiculoAno}" IsEnabled="{Binding !ModoVisualizacao}"
                                     HorizontalAlignment="Left" Width="90" MaxLength="9"
                                     Watermark="2018" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Classes="formlabel" Text="Placa" />
                            <TextBox Grid.Row="2" Grid.Column="3"
                                     Text="{Binding VeiculoPlaca}" IsEnabled="{Binding !ModoVisualizacao}"
                                     b:MaiusculoBehavior.Ativo="True"
                                     HorizontalAlignment="Left" Width="110" MaxLength="8"
                                     Watermark="ABC1D23" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formlabel" Text="Observação" />
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                     Text="{Binding Observacao}" IsEnabled="{Binding !ModoVisualizacao}"
                                     Watermark="Observação da pré-venda (opcional)" />
                        </Grid>

                        <!-- ===== ITENS ===== -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Width="820" HorizontalAlignment="Left" Margin="0,12,0,4">
                            <TextBlock Grid.Column="0" Classes="formsecao" Text="ITENS" />
                            <Border Grid.Column="1" Classes="formsecaoLinha" />
                            <Button Grid.Column="2" Content="+ Buscar peça (F2)" Classes="secundario"
                                    Command="{Binding AbrirCatalogoCommand}"
                                    IsVisible="{Binding !ModoVisualizacao}"
                                    Margin="8,0,0,0" Cursor="Hand" />
                        </Grid>

                        <!-- Cabeçalho das colunas do grid de itens -->
                        <Grid ColumnDefinitions="*,80,100,90,100,28" Width="820" HorizontalAlignment="Left"
                              Margin="0,0,0,2"
                              IsVisible="{Binding Itens.Count}">
                            <TextBlock Grid.Column="0" Text="DESCRIÇÃO" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextoSecundario}" />
                            <TextBlock Grid.Column="1" Text="QTD" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextoSecundario}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="2" Text="UNITÁRIO" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextoSecundario}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="3" Text="DESCONTO" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextoSecundario}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="4" Text="TOTAL" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextoSecundario}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                        </Grid>

                        <!-- Linhas editáveis -->
                        <ItemsControl ItemsSource="{Binding Itens}" Width="820" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreVendaItemViewModel">
                                  <!-- Fundo da linha pisca amarelo (#FEF9C3) ao adicionar a peça. -->
                                  <Border Background="{Binding BrushFundoLinha}" CornerRadius="2" Padding="2,0" Margin="0,0,0,2">
                                    <Grid ColumnDefinitions="*,80,100,90,100,28">
                                        <TextBox Grid.Column="0" Text="{Binding DescricaoProduto}"
                                                 IsEnabled="False" Margin="0,0,4,0" />
                                        <TextBox Grid.Column="1" Text="{Binding QtdTexto}"
                                                 IsEnabled="{Binding $parent[ItemsControl].((vm:PreVendaFormViewModel)DataContext).ModoVisualizacao, Converter={x:Static BoolConverters.Not}}"
                                                 TextAlignment="Right" Margin="0,0,4,0" Watermark="1,00" />
                                        <TextBox Grid.Column="2" Text="{Binding VlrUnitarioTexto}"
                                                 IsEnabled="{Binding $parent[ItemsControl].((vm:PreVendaFormViewModel)DataContext).ModoVisualizacao, Converter={x:Static BoolConverters.Not}}"
                                                 TextAlignment="Right" Margin="0,0,4,0" Watermark="0,00" />
                                        <!-- Realce âmbar atrás do campo quando a linha tem desconto. -->
                                        <Border Grid.Column="3" Margin="0,0,4,0" CornerRadius="2"
                                                Background="{Binding TemDesconto, Converter={x:Static conv:DescontoFundoConverter.Instancia}}">
                                            <TextBox Text="{Binding VlrDescontoTexto}"
                                                     Background="Transparent"
                                                     IsEnabled="{Binding $parent[ItemsControl].((vm:PreVendaFormViewModel)DataContext).ModoVisualizacao, Converter={x:Static BoolConverters.Not}}"
                                                     TextAlignment="Right" Watermark="0,00" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding VlrTotalItemTexto}"
                                                   FontFamily="{DynamicResource FonteMono}" FontSize="12"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Margin="0,0,8,0" />
                                        <Button Grid.Column="5" Classes="secundario"
                                                Width="28" Padding="0"
                                                Command="{Binding $parent[ItemsControl].((vm:PreVendaFormViewModel)DataContext).RemoverItemCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:PreVendaFormViewModel)DataContext).ModoVisualizacao, Converter={x:Static BoolConverters.Not}}"
                                                ToolTip.Tip="Remover" Cursor="Hand"
                                                Content="✕" />
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- vazio -->
                        <TextBlock Text="Nenhum item. Clique em &quot;+ Buscar peça&quot; para adicionar."
                                   FontSize="11" Foreground="{DynamicResource BrushTextoMudo}"
                                   Margin="0,2,0,0"
                                   IsVisible="{Binding !Itens.Count}" />

                        <!-- ===== TOTAIS ===== -->
                        <Grid ColumnDefinitions="Auto,*" Width="820" HorizontalAlignment="Left" Margin="0,12,0,4">
                            <TextBlock Grid.Column="0" Classes="formsecao" Text="TOTAIS" />
                            <Border Grid.Column="1" Classes="formsecaoLinha" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Width="820" HorizontalAlignment="Left">
                            <StackPanel Grid.Column="1" Spacing="4" Width="280" HorizontalAlignment="Right">
                                <Grid ColumnDefinitions="*,120">
                                    <TextBlock Grid.Column="0" Text="Subtotal dos itens" Classes="formlabel"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalItensTexto}"
                                               FontFamily="{DynamicResource FonteMono}" FontSize="12"
                                               Foreground="{DynamicResource BrushTexto}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="*,120">
                                    <TextBlock Grid.Column="0" Text="Desconto" Classes="formlabel"
                                               HorizontalAlignment="Right" />
                                    <TextBox Grid.Column="1" Text="{Binding VlrDescontoTexto}"
                                             IsEnabled="{Binding !ModoVisualizacao}"
                                             TextAlignment="Right" Watermark="0,00" />
                                </Grid>
                                <Border Background="{DynamicResource BrushBordaSuave}" Height="1" Margin="0,2" />
                                <!-- Faixa de destaque do TOTAL (o número que o vendedor mais olha). -->
                                <Border Background="#EFF6FF" CornerRadius="3" Padding="8,4">
                                    <Grid ColumnDefinitions="*,120">
                                        <TextBlock Grid.Column="0" Text="TOTAL" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTexto}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding VlrTotalTexto}"
                                                   FontFamily="{DynamicResource FonteMono}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{Binding VlrTotal, Converter={x:Static conv:TotalBrushConverter.Instancia}}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- mensagem de erro -->
                        <TextBlock Text="{Binding MensagemErro}"
                                   IsVisible="{Binding MensagemErro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{DynamicResource BrushErro}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="2"
                             IsVisible="{Binding Carregando}" />

                <!-- RODAPÉ dois modos -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource BrushBorda}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Fechar" Classes="secundario"
                                Command="{Binding CancelarCommand}"
                                IsVisible="{Binding ModoVisualizacao}" Cursor="Hand" />
                        <Button Content="Editar" Classes="primario"
                                Command="{Binding HabilitarEdicaoCommand}"
                                IsVisible="{Binding ModoVisualizacao}" Cursor="Hand" />
                        <Button Content="Cancelar" Classes="secundario"
                                Command="{Binding CancelarCommand}"
                                IsVisible="{Binding !ModoVisualizacao}"
                                IsEnabled="{Binding !Carregando}" Cursor="Hand" />
                        <Button Content="Salvar" Classes="primario"
                                Command="{Binding SalvarCommand}"
                                IsVisible="{Binding !ModoVisualizacao}"
                                IsEnabled="{Binding !Carregando}" Cursor="Hand" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</UserControl>
