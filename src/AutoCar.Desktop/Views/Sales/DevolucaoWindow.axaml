<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoCar.Desktop.ViewModels.Sales"
        xmlns:views="using:AutoCar.Desktop.Views.Sales"
        x:Class="AutoCar.Desktop.Views.Sales.DevolucaoWindow"
        x:DataType="vm:DevolucaoFormViewModel"
        Width="880" Height="600"
        MinWidth="720" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Devolução de Venda"
        Background="{DynamicResource BrushFundo}">

    <!-- ESC fecha a janela sem registrar devolução. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelarCommand}" />
    </Window.KeyBindings>

    <views:DevolucaoFormView />
</Window>
