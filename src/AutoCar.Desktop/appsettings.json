{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=autocar;Username=postgres;Password=postgres"
  },
  "App": {
    "Nome": "AutoCar ERP",
    "Versao": "1.0.0",
    "TimeoutSessaoMinutos": 30,
    "TimeZone": "America/Sao_Paulo"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/autocar-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
