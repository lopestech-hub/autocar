<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         Tema AutoCar ERP — Precision & Density / Compacto Enterprise
         Paleta + tipografia + estilos de componente. Consumir via DynamicResource.
         =================================================================== -->

    <Styles.Resources>
        <ResourceDictionary>
            <!-- ===== FONTES ===== -->
            <FontFamily x:Key="FonteInterface">Segoe UI</FontFamily>
            <FontFamily x:Key="FonteMono">Consolas</FontFamily>

            <!-- ===== FUNDOS ===== -->
            <Color x:Key="ColorFundo">#F0F2F5</Color>
            <Color x:Key="ColorFundoCard">#FFFFFF</Color>
            <Color x:Key="ColorFundoSidebar">#1E293B</Color>
            <Color x:Key="ColorFundoSidebarHover">#334155</Color>
            <Color x:Key="ColorFundoSidebarAtivo">#3B82F6</Color>
            <Color x:Key="ColorFundoInput">#FFFFFF</Color>
            <Color x:Key="ColorFundoDesabilitado">#F1F5F9</Color>
            <Color x:Key="ColorFundoHover">#F8FAFC</Color>
            <Color x:Key="ColorFundoSelecionado">#EFF6FF</Color>
            <Color x:Key="ColorFundoHeader">#F8FAFC</Color>

            <!-- ===== BORDAS ===== -->
            <!-- Borda de repouso forte (azul-ardósia #1E293B) — campo bem definido, preferência do
                 Julio (validada na tela). O foco continua azul (#3B82F6, ColorBordaFoco). -->
            <Color x:Key="ColorBorda">#1E293B</Color>
            <Color x:Key="ColorBordaSuave">#E2E8F0</Color>
            <Color x:Key="ColorBordaFoco">#3B82F6</Color>
            <Color x:Key="ColorBordaErro">#EF4444</Color>

            <!-- ===== TEXTO ===== -->
            <Color x:Key="ColorTexto">#1E293B</Color>
            <Color x:Key="ColorTextoSecundario">#64748B</Color>
            <Color x:Key="ColorTextoMudo">#94A3B8</Color>
            <Color x:Key="ColorTextoInverso">#FFFFFF</Color>
            <Color x:Key="ColorTextoSidebar">#CBD5E1</Color>

            <!-- ===== AÇÃO ===== -->
            <Color x:Key="ColorPrimario">#3B82F6</Color>
            <Color x:Key="ColorPrimarioHover">#2563EB</Color>
            <Color x:Key="ColorPrimarioPressed">#1D4ED8</Color>

            <!-- ===== SEMÂNTICO ===== -->
            <Color x:Key="ColorSucesso">#22C55E</Color>
            <Color x:Key="ColorAlerta">#F59E0B</Color>
            <Color x:Key="ColorErro">#EF4444</Color>

            <!-- ===== BRUSHES ===== -->
            <SolidColorBrush x:Key="BrushFundo" Color="{StaticResource ColorFundo}" />
            <SolidColorBrush x:Key="BrushFundoCard" Color="{StaticResource ColorFundoCard}" />
            <SolidColorBrush x:Key="BrushFundoSidebar" Color="{StaticResource ColorFundoSidebar}" />
            <SolidColorBrush x:Key="BrushFundoSidebarHover" Color="{StaticResource ColorFundoSidebarHover}" />
            <SolidColorBrush x:Key="BrushFundoSidebarAtivo" Color="{StaticResource ColorFundoSidebarAtivo}" />
            <SolidColorBrush x:Key="BrushFundoInput" Color="{StaticResource ColorFundoInput}" />
            <SolidColorBrush x:Key="BrushFundoDesabilitado" Color="{StaticResource ColorFundoDesabilitado}" />
            <SolidColorBrush x:Key="BrushFundoHover" Color="{StaticResource ColorFundoHover}" />
            <SolidColorBrush x:Key="BrushFundoHeader" Color="{StaticResource ColorFundoHeader}" />

            <SolidColorBrush x:Key="BrushBorda" Color="{StaticResource ColorBorda}" />
            <SolidColorBrush x:Key="BrushBordaSuave" Color="{StaticResource ColorBordaSuave}" />
            <SolidColorBrush x:Key="BrushBordaFoco" Color="{StaticResource ColorBordaFoco}" />
            <SolidColorBrush x:Key="BrushBordaErro" Color="{StaticResource ColorBordaErro}" />

            <SolidColorBrush x:Key="BrushTexto" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="BrushTextoSecundario" Color="{StaticResource ColorTextoSecundario}" />
            <SolidColorBrush x:Key="BrushTextoMudo" Color="{StaticResource ColorTextoMudo}" />
            <SolidColorBrush x:Key="BrushTextoInverso" Color="{StaticResource ColorTextoInverso}" />
            <SolidColorBrush x:Key="BrushTextoSidebar" Color="{StaticResource ColorTextoSidebar}" />

            <SolidColorBrush x:Key="BrushPrimario" Color="{StaticResource ColorPrimario}" />
            <SolidColorBrush x:Key="BrushPrimarioHover" Color="{StaticResource ColorPrimarioHover}" />
            <SolidColorBrush x:Key="BrushErro" Color="{StaticResource ColorErro}" />

            <!-- ===== OVERRIDE DO MENU (FluentTheme) =====
                 Por padrão o FluentTheme renderiza o popup do submenu com fundo escuro e
                 controla a cor do texto nos estados (some no hover). Sobrescrever esses
                 resource-keys deixa o submenu claro e legível, alinhado ao app, sem mexer
                 em template/animação (evita o flicker). -->
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource ColorFundoCard}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource ColorBorda}" />
            <SolidColorBrush x:Key="MenuBackground" Color="{StaticResource ColorFundoCard}" />
            <SolidColorBrush x:Key="MenuBorderBrush" Color="{StaticResource ColorBorda}" />

            <!-- Texto dos itens em todos os estados: sempre escuro e legível -->
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundSelected" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundSubMenuOpened" Color="{StaticResource ColorTexto}" />

            <!-- Fundo dos itens: transparente normal, azul-claro no hover/seleção -->
            <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource ColorFundoSelecionado}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource ColorFundoSelecionado}" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundSelected" Color="{StaticResource ColorFundoSelecionado}" />

            <!-- ===== OVERRIDE DO COMBOBOX (FluentTheme) =====
                 Mesmo gotcha do menu: o dropdown do ComboBox usa o tema do FluentTheme,
                 que pode apagar o texto do item no hover/seleção. Sobrescrever os resources
                 mantém o item sempre legível (texto escuro) com hover/seleção azul-claro,
                 alinhado ao app. Cobre todos os ComboBox (Tipo Pessoa de Cliente/Fornecedor). -->
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="{StaticResource ColorTextoMudo}" />

            <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource ColorFundoSelecionado}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{StaticResource ColorFundoSelecionado}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource ColorFundoSelecionado}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource ColorFundoSelecionado}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource ColorFundoSelecionado}" />

            <!-- Fundo do popup do dropdown -->
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource ColorFundoCard}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource ColorBorda}" />

            <!-- Fundo do ComboBox FECHADO (a caixa em si): branco em todos os estados,
                 igual aos TextBox ao lado. Por padrão o FluentTheme deixa cinza-escuro
                 no hover/foco, destoando dos demais campos do formulário. -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource ColorFundoInput}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource ColorFundoInput}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource ColorFundoInput}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource ColorFundoInput}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource ColorFundoSelecionado}" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{StaticResource ColorTexto}" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource ColorTexto}" />

            <!-- Borda visível em repouso (o FluentTheme deixa transparente até o hover,
                 por isso a caixa parecia "solta"). Igual à borda dos TextBox. -->
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource ColorBorda}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource ColorBordaFoco}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource ColorBordaFoco}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource ColorBordaFoco}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource ColorBorda}" />
            <!-- Espessura da borda 1px em todos os estados (o FluentTheme usa 2px no foco). -->
            <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>
            <!-- Desabilitado (modo visualização): texto escuro legível, não o cinza-claro
                 do FluentTheme que sumia no fundo. Mesma lógica do TextBox:disabled. -->
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource ColorTexto}" />
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===================================================================
         COMPONENTES
         =================================================================== -->

    <!-- Tooltip: fundo azul-ardósia do tema (ColorTexto #1E293B) em vez do escuro padrão do
         Avalonia — destaca mais, conversa com a marca e usa cor da paleta. Texto branco, borda
         sutil, cantos 3px. Estilo global: vale para todos os tooltips do sistema. -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BrushTexto}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoInverso}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushTextoSecundario}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{DynamicResource FonteInterface}" />
    </Style>

    <!-- Label de formulário denso (à esquerda do campo, alinhado à direita) -->
    <Style Selector="TextBlock.formlabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoSecundario}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Título de seção dentro de formulário (ex: "IDENTIFICAÇÃO"). Cor da marca (azul
         primário) para destacar o agrupamento sem competir com as labels cinza dos campos.
         Acompanhar de uma linha divisória (Border 1px) ao lado — ver formsecaoLinha. -->
    <Style Selector="TextBlock.formsecao">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimario}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Linha divisória que acompanha o título de seção (preenche a largura ao lado do texto). -->
    <Style Selector="Border.formsecaoLinha">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrushBordaSuave}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- TextBox padrão (24px). MinHeight=24 é obrigatório: o FluentTheme usa MinHeight 32
         por padrão, que vence o Height e deixava o campo a 32px (mais alto que o ComboBox). -->
    <Style Selector="TextBox">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource FonteInterface}" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTexto}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushPrimario}" />
    </Style>

    <!-- Cor do texto digitado sempre escura, em todos os estados.
         O FluentTheme troca o Foreground do TextBox no foco/hover, o que
         deixava o texto branco sobre branco — fixamos no próprio TextBox
         (o TextPresenter herda essa cor). -->
    <Style Selector="TextBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
    </Style>
    <Style Selector="TextBox:focus-within">
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordaFoco}" />
    </Style>

    <!-- Forçar fundo branco e borda fina (1px) do Border interno em todos os estados.
         O FluentTheme troca o Background e ENGROSSA a borda para 2px no foco/hover —
         fixamos fundo branco + BorderThickness 1 aqui. -->
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordaFoco}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordaFoco}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordaFoco}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
    </Style>
    <!-- Modo visualização (campo desabilitado): fundo azul-claro de destaque (#EFF6FF),
         o mesmo do hover das listas — sinaliza "somente leitura" de forma elegante,
         em vez do cinza apagado. Vale para TextBox, ComboBox e NumericUpDown. -->
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BrushFundoSelecionado}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorda}" />
    </Style>

    <!-- TextBox de login (28px — tela de baixa densidade, respiro maior) -->
    <Style Selector="TextBox.login">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- ComboBox: alinhado aos campos do formulário (24px, radius 2) e fundo branco
         em todos os estados. Mesma técnica do TextBox: forçar o Border interno
         (PART_BackgroundElement), pois o FluentTheme escurece a caixa no hover/foco. -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorda}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordaFoco}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordaFoco}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox:focus-within /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordaFoco}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox:pressed /template/ Border#Background">
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox:disabled /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrushFundoSelecionado}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorda}" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
    </Style>
    <!-- O valor selecionado é exibido pelo ContentPresenter interno; no modo visualização
         (desabilitado) ele precisa de cor e opacidade explícitas para não sumir. -->
    <Style Selector="ComboBox:disabled /template/ ContentControl#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ComboBox:disabled /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- (NumericUpDown removido: valores monetários usam TextBox com parse no ViewModel —
         o NumericUpDown do Fluent dava problema de estilo/borda. Ver LimiteCreditoTexto.) -->

    <!-- ===================================================================
         BOTÃO-SELETOR (campo que abre uma janela de busca: cliente por nome/código, etc.)
         Parece um campo de formulário (24px, borda, fundo branco, texto à esquerda) mas é um
         Button — clicar/Enter abre o seletor. Padrão reutilizável (cliente, e futuros).
         =================================================================== -->
    <Style Selector="Button.seletor">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource FonteInterface}" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.seletor /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
    </Style>
    <Style Selector="Button.seletor:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushFundoInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordaFoco}" />
    </Style>
    <Style Selector="Button.seletor:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushFundoSelecionado}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Botão primário (26px) -->
    <Style Selector="Button.primario">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{DynamicResource FonteInterface}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource BrushPrimario}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoInverso}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primario:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushPrimarioHover}" />
    </Style>

    <Style Selector="Button.primario:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimarioPressed}" />
    </Style>

    <Style Selector="Button.primario:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushBorda}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Botão primário grande (login, 32px largura total) -->
    <Style Selector="Button.primario.grande">
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Botão Faturar — verde da família "Faturada" (#22C55E). Cor com significado: confirma a venda
         e baixa o estoque. Mesma altura/forma do primário; só a cor muda. -->
    <Style Selector="Button.faturar">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{DynamicResource FonteInterface}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="#22C55E" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoInverso}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.faturar:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#16A34A" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoInverso}" />
    </Style>

    <Style Selector="Button.faturar:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#15803D" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoInverso}" />
    </Style>

    <Style Selector="Button.faturar:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushBorda}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Botão secundário -->
    <Style Selector="Button.secundario">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource FonteInterface}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource BrushFundoCard}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.secundario:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushFundoHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordaFoco}" />
        <!-- Forçar texto escuro no hover: o FluentTheme aplica cor clara que sumia no fundo. -->
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
    </Style>
    <Style Selector="Button.secundario:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushFundoHover}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
    </Style>

    <!-- ===================================================================
         SHELL ESTILO ERP CLÁSSICO (menu de texto + toolbar de ícones)
         =================================================================== -->

    <!-- Menu superior de texto -->
    <Style Selector="Menu.topo">
        <Setter Property="Background" Value="{DynamicResource BrushFundoCard}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontFamily" Value="{DynamicResource FonteInterface}" />
    </Style>
    <!-- Categorias de topo (fundo branco da faixa): texto escuro. Os itens do submenu
         têm cor controlada pelos resources MenuFlyoutItem* (definidos acima), que cobrem
         todos os estados sem flicker e sem o texto sumir no hover. -->
    <Style Selector="Menu.topo > MenuItem">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTexto}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Botão da toolbar de ícones (ícone grande + legenda em até 2 linhas) -->
    <Style Selector="Button.toolbaritem">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.toolbaritem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushFundoHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorda}" />
    </Style>

    <!-- Item de menu da sidebar -->
    <Style Selector="Button.menuitem">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource FonteInterface}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoSidebar}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushFundoSidebarHover}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoInverso}" />
    </Style>

    <!-- Botão "Sair" da sidebar (texto sutil) -->
    <Style Selector="Button.sair">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFundoSidebarHover}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.sair:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushFundoSidebarHover}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextoInverso}" />
    </Style>

</Styles>
